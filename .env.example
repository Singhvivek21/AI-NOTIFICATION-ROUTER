# .env.example

# The API key required to authenticate with the Google Gemini API
GEMINI_API_KEY=

# The specific Gemini model version used for fast, general-purpose tasks
FLASH_MODEL=gemini-2.5-flash

# The specific Gemini model version used for complex reasoning and reflection tasks
PRO_MODEL=gemini-2.5-pro

# The directory path where the input CSV datasets are located
DATASET_PATH=dataset/

# The directory path where multimodal media files (images, audio) are located
MEDIA_PATH=dataset/media/

# The directory path containing the Jinja prompt templates
PROMPTS_PATH=prompts/

# The file path where the final processed routing decisions will be saved
OUTPUT_PATH=output/output.csv

# The logging level for the application (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# The maximum number of concurrent workers to use for batch processing
MAX_WORKERS=10

# Whether to enable caching for API requests or intermediate results
CACHE_ENABLED=true
